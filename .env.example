# Copia este archivo como .env y pega tu key de Groq
# Local ("node server.js") lee este archivo.
# En Vercel usa las Variables de Entorno del proyecto (misma variable: GROQ_API_KEY).
GROQ_API_KEY=gsk_tu_key_aqui

# OPCIONAL: si la defines, el navegador debe enviar "x-app-token" con este valor,
# si no las llamadas a /api/groq se rechazan (403). Útil para acceso solo autorizado.
# APP_TOKEN=tu_token_secreto

# Fuentes de noticias (vía /api/config; en Vercel = Variables del proyecto).
# RSS_PRI: tu feed de RSS.app
# RSS_PRI=https://rss.app/feeds/_xcLux4OS9bFKsrNa.xml
# RSS_SEC: feed secundario (si queda vacío usa Google News México)
# RSS_SEC=https://news.google.com/rss/search?q=accidente+OR+bloqueo+OR+asalto+carretera+mexico&hl=es-419&gl=MX&ceid=MX:es-419

# Modelos preferidos (opcional)
# GROQ_MODEL=openai/gpt-oss-20b
# REPORT_MODEL=openai/gpt-oss-120b

# OPCIONAL: mejora la ubicación de alertas con Google Geocoding y Roads API.
# Activa ambas APIs, limita la cuota diaria en Google Cloud y guarda la clave solo aquí/Vercel.
# GOOGLE_MAPS_API_KEY=AIza_tu_clave_aqui
