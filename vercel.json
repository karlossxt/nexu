{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/acerca", "dest": "/acerca.html" },
    { "src": "/acerca.html", "dest": "/acerca.html" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "handle": "filesystem" }
  ]
}
